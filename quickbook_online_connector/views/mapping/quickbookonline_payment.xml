<odoo>
    <data>

        <!--========== Quickbook Online Payment Mapping ===============-->

        <record id="quickbookonline_payment_form" model="ir.ui.view">
            <field name="name">quickbookonline.payment.form</field>
            <field name="model">quickbookonline.payment</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Payment Mapping" create="false" edit="false">
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="odoo_id" readonly="1"/>
                        <field name="quickbook_id" readonly="1"/>
                        <field name="instance_id" readonly="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="quickbookonline_payment_list" model="ir.ui.view">
            <field name="name">quickbookonline.payment.list</field>
            <field name="model">quickbookonline.payment</field>
           
            <field name="arch" type="xml">
                <list create="false" string="Quickbook Payment Mapping">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="odoo_id"/>
                    <field name="quickbook_id"/>
                    <field name="instance_id" readonly="1"/>
                    <field name='created_by' readonly='1'/>
                    <field name="create_date" readonly="1"/>
                    <field name="write_date" readonly="1"/>
                    <field name='is_sync'/>
                </list>
            </field>
        </record>

        <!-- Search View for Qucikbook Payments  -->
        <record id="quickbookonline_payment_search" model="ir.ui.view">
            <field name="name">quickbookonline.payment.search</field>
            <field name="model">quickbookonline.payment</field>
            <field name="arch" type="xml">
                <search string="Payment Mapping">
                    <field name="name" filter_domain="[('name','ilike',self)]"/>
                    <field name="odoo_id"/>
                    <field name="quickbook_id"/>
                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by':'instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="quickbook_online_payment_list_action" model="ir.actions.act_window">
            <field name="name">Quickbook Online Payment Mapping</field>
            <field name="res_model">quickbookonline.payment</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_group_by_storage_type":1,"search_default_group_by_instance":1}</field>
            <field name="view_id" ref="quickbookonline_payment_list"/>
            <field name="search_view_id" ref = "quickbookonline_payment_search"/>
        </record>
    </data>
</odoo>
