<odoo>
    <data>

        <!--========== Quickbook Online Payment Method Map Mapping ===============-->

        <record id="quickbookonline_payment_method_map_form" model="ir.ui.view">
            <field name="name">quickbookonline.payment.method.map.form</field>
            <field name="model">quickbookonline.payment.method.map</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Payment Method Map Mapping">
                    <group>
                        <field name="name"/>
                        <field name='quickbook_payment_method'/>
                        <field name="instance_id" readonly="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="quickbookonline_payment_method_map_list" model="ir.ui.view">
            <field name="name">quickbookonline.payment.method.map.list</field>
            <field name="model">quickbookonline.payment.method.map</field>
          
            <field name="arch" type="xml">
                <list string="Quickbook Payment Method Map Mapping">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="odoo_id"/>
                    <field name="quickbook_id"/>
                    <field name="instance_id"/>
                    <field name='created_by' readonly='1'/>
                    <field name="create_date" readonly="1"/>
                    <field name="write_date" readonly="1"/>
                </list>
            </field>
        </record>

        <!-- Search View for Qucikbook Payment Method Maps  -->
        <record id="quickbookonline_payment_method_map_search" model="ir.ui.view">
            <field name="name">quickbookonline.payment.method.map.search</field>
            <field name="model">quickbookonline.payment.method.map</field>
            <field name="arch" type="xml">
                <search string="Payment Method Map Mapping">
                    <field name="name" filter_domain="[('name','ilike',self)]"/>
                    <field name="odoo_id"/>
                    <field name="quickbook_id"/>
                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by':'instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="quickbook_online_payment_method_map_list_action" model="ir.actions.act_window">
            <field name="name">Quickbook Online Payment Method Map Mapping</field>
            <field name="res_model">quickbookonline.payment.method.map</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_group_by_storage_type":1,"search_default_group_by_instance":1}</field>
            <field name="view_id" ref="quickbookonline_payment_method_map_list"/>
            <field name="search_view_id" ref = "quickbookonline_payment_method_map_search"/>
        </record>
    </data>
</odoo>
