											</div>
											<div>
												<field name="quickbook_expense_account" domain="[('is_quickbook','=',True)]"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
												<label string="QuickBook Default Tax Code" for="quickbook_account_tax_code"/>
												<div class="text-muted" groups="base.group_no_one">
													It is used to which type of "Tax" you want to apply on Invoice/Sale line at QuickBook End.<br/>**In Invoice/Sale lines and Default Tax Code Taxes must be same otherwise not set or may be different at QuickBook End.
												</div>
												<div>
													<field name="quickbook_account_tax_code"/>
												</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
												<label string="QuickBook Default Code" for="quickbook_account_code"/>
												<div class="text-muted" groups="base.group_no_one">
													To track the taxable and non-taxable status of Invoice/Sale/Purchase lines<br/>This will be applicable only if lines contain Taxes otherwise not.
												</div>
												<div>
													<field name="quickbook_account_code"/>
												</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
												<label string="QuickBook Default Tax For Purchase" for="quickbook_account_purchase_tax_code"/>
												<div class="text-muted" groups="base.group_no_one">
													It is used to which type of "Tax" you want to apply on Purchase Order line at QuickBook End.
												</div>
												<div>
													<field name="quickbook_account_purchase_tax_code"/>
												</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
