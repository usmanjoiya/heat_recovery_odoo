													Account Type must be 'other current Assets' and Detail Type must be Inventory<br/>at QuickBook End in Chart of accounts.(*required for "Storable Product")
												</div>
												<div>
													<field name="quickbook_asset_account" domain="[('is_quickbook','=',True)]"/>
