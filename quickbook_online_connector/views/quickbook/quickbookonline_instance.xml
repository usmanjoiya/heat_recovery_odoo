<odoo>
	<data>
		<record id="quickbook_online_mapping_form" model="ir.ui.view">
			<field name="name">Quickbook Online Connection Form</field>
			<field name="model">quickbookonline.instance</field>
			<field name="type">form</field>
			<field name="arch" type="xml">
				<form string="Quickbook Online Instance">
					<header>
							<button name="test_connection"
								type='object' 
								icon="fa-pencil-square-o" 
								class="oe_highlight" 
								string='Test Connection'/>
							<button name="disconnect_connection"
								type='object' 
								class="text-danger"
								invisible='not connection_status'>
								<span class="fa fa-chain-broken"/>
								Disconnect
								</button>
					</header>
					<sheet>
						<div name="button_box" class="oe_button_box">
							<button name="toggle_active" type="object" class="oe_stat_button" icon="fa-check">
								<field name="active" options="{'terminology': 'active'}" widget="boolean_button"/>
							</button>
						</div>
						<field name="connection_status" invisible="1"/>
						<widget name="web_ribbon" text="Connected"
							invisible="connection_status != True"/>
						<widget name="web_ribbon" text="Not Connected" bg_color="bg-danger"
							invisible="connection_status != False"/>
						
						<div class="oe_title">
							<label for="name" string="Instance name"/>
							<h1><field name="name" placeholder="e.g. Quickbook Online Connector Name"/></h1>
						</div>
                        <group name="quickbookonelin_environment" col="2">
							 <field name='environment'/>
						</group>
						
						<notebook>
							<page string="Api Details" name='api_details'>
								<div class="row mt16 o_settings_container">
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Client id" for="client_id"/>
											<div>
												<field name="client_id"/>
											</div>
										</div>
									</div>
                                    <div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Client Key" for="client_key"/>
											<div>
												<field name="client_key"/>
											</div>
										</div>
									</div>
								</div>
                                <div class="row mt16 o_settings_container">
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Redirect url" for="redirect_url"/>
											<div class="text-muted">
												Redirect URI should be same at odoo and quickbook end.<br/> Please add "/quickbook_online_connector" after your Odoo URL.
											</div>
											<div>
												<field name="redirect_url" style="width:320px;"/>
											</div>
										</div>
									</div>
                                    <div class="col-xs-12 col-md-6 o_setting_box" invisible="connection_status == False">
										<div class="o_setting_right_pane">
											<label string="Company(Realm Id)" for="realmId"/>
											<div>
												<field name="realmId" readonly="1" groups="base.group_no_one"/>
											</div>
											<div invisible="not qbo_company_name">
												<strong class="text-primary">
													<field name="qbo_company_name" readonly="1"/>
												</strong>
											</div>
										</div>
									</div>
								</div>
                                <div class="row mt16 o_settings_container" groups='base.group_no_one' invisible="connection_status == False">
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Refresh Token" for="refresh_token"/>
											<div>
												<field name="refresh_token" readonly="connection_status"/>
											</div>
										</div>
									</div>
                                    <div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Access Token" for="access_token"/>
											<div>
												<field name="access_token" readonly="connection_status"/>
											</div>
										</div>
									</div>
								</div>	
							</page>
							
							<page string="Default Odoo Settings" name='quickbook_default_settings'>
								<div class="row mt16 o_settings_container">
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Product Category" for="default_category_id"/>
											<div>
												<field name="default_category_id"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Discount Product For Order" for="discount_product_id"/>
											<div>
												<field name="discount_product_id"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Company" for="company_id"/>
											<div>
												<field name="company_id" options="{'no_create' : True}"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Stock Warehouse" for="default_warehouse_id"/>
											<div>
												<field name="default_warehouse_id"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Stock Location" for="location_id"/>
											<div>
												<field name="location_id"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Pricelist " for="default_pricelist_id"/>
											<div>
												<field name="default_pricelist_id"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Sales Team " for="default_sales_team"/>
											<div>
												<field name="default_sales_team"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Default Sales Person" for="default_sales_user"/>
											<div>
												<field name="default_sales_user"/>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Avoid Duplicity" for="avoid_duplicity"/>
											<div>
												<field name="avoid_duplicity" readonly="connection_status" help="Stop duplicating product with the same SKU"/>
											</div>
											<div class='text-muted'>
												Stop creating duplicate products in Odoo with same SKU(Internal Reference) after import from Quickbook
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<label string="Auto Sync Stock" for="auto_sync_stock"/>
											<div>
												<field name="auto_sync_stock" readonly="connection_status" help="Real time Product Stock will be synced from Odoo to Quickbook"/>
											</div>
											<div class='text-muted'>
												Sync Real time stock(on-hand) from Odoo to Quickbook.
											</div>
										</div>
									</div>
								</div>
							</page>

							<page string="Quickbook Default Import Data" name='quickbook_import_data' invisible="connection_status == False">
								<div class="row mt16 o_settings_container">
									<div class="col-xs-12 col-md-6 o_setting_box">
										<div class="o_setting_right_pane">
											<button name="get_sale_tax"
