<odoo>
	<data>
    		<!-- Quickbook Synchronization -->
		<record id="quickbookonline_synchronization_form" model="ir.ui.view">
            <field name="name">quickbook.online.synchronization.form</field>
            <field name="model">quickbookonline.synchronization</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
				<form create="false" save="false" string="Quickbook Online Synchronization" >
					<header>
						<separator colspan="5" string="Quickbook Online Synchronization"/>
					</header>
					<sheet>
						 <group name="d" col="3">
							<!-- <label for="id" string="Export Synchronization"/> -->
								<button icon="fa-th-list"
												name="export_synchronisation"
												string="Export/Update Synchronization"
												type="object"
												class="oe_highlight wk_sync_button"
												help="Export / Update Data From Odoo To Quickbook"/>

								<newline/>

							<!-- <label for="id" string="Import Synchronization"/> -->
								<button icon="fa-sitemap"
												class="oe_highlight wk_sync_button"
												name="import_synchronization"
												string="Import Synchronisation"
												type="object"
												help="It'll Import/Update Data From Quickbook To Odoo."/>
								<newline/>

							<!-- <label for="id" string="Reset Mapping"/> -->
								<button icon="fa-trash-o"
											class="oe_highlight"
											name="reset_mapping"
											confirm="Are you sure you want to Reset All Mappings?"
											string="Reset All Mapping" type="object" help="Warning It will reset(delete) All Base Mappind Data From Odoo"/>
						</group>
					</sheet>
				</form>
			</field>
        </record>

		<record id="quickbookonline_synchronization_action" model="ir.actions.act_window">
            <field name="name">Quickbook Online Synchronization</field>
            <field name="res_model">quickbookonline.synchronization</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="quickbookonline_synchronization_form"/>
        </record>
    </data>
</odoo>
