        <!-- Import Crons -->
        <record id="ir_cron_quickbook_online_category" model="ir.cron">
            <field name="name">QBO: Import Categories From Quickbook</field>
            <field name="model_id" ref="quickbook_online_connector.model_quickbookonline_synchronization"/>
            <field name="state">code</field>
            <field name="code">model.sync_data_of_quickbook('category','importCategoryLimit','import')</field>
			<field name="interval_number">5</field>
            <field name="interval_type">hours</field>
			<field name="active" eval="False"/>
