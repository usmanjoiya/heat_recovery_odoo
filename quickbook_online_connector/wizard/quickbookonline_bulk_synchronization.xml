<odoo>
    <record id="id_quickbookonline_bulk_synchronisation_form" model="ir.ui.view">
            <field name="name">Quickbook Online Bulk Synchronisation</field>
            <field name="model">quickbookonline.bulk.synchronisation</field>
            <field name="arch" type="xml">
                <form string="Sync">
                    <group col='2'>
                        <group col='2'>
                            <field name="object_type" widget="selection" required="1"/>
                            <field name='action_2' widget="selection" 
                            invisible="action == 'import'" readonly="object_type in ['partner_category','account','order','invoice','payment','purchase_order']"/>
                            <field name='action_3' widget='selection' invisible="action == 'export'" readonly="object_type in ['partner_category','account','order','invoice','purchase_order'] or action == 'import'"/>
                            <field name='action' invisible="1"/>
                            <field name='limit' required='1'/>
                        </group>
                    </group>
                     <group col='2'>
                        <field name="instance_id" widget="selection" 
						required='1' string="Instance Id"/>
                    </group>
                    <footer>
                        <button name="start_action_quickbookonline_synchronization"
                                string="Action Now"
                                type="object"
                                class="oe_highlight"/>
                        or
                        <button string="Cancel" class='oe_link' special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
