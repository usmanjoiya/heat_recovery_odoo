<odoo>
    <record id="id_quickbookonline_manual_synchronisation_form" model="ir.ui.view">
            <field name="name">Quickbook Online Manual Synchronisation</field>
            <field name="model">quickbookonline.manual.synchronisation</field>
            <field name="arch" type="xml">
                <form string="Sync">
                     <group>
                        <field name="instance_id" widget="selection" 
						required='1' string="Instance Id"/>
                    </group>
                    <footer>
                        <button name="start_action_manual_synchronization"
                                string="Export Now"
                                type="object"
                                class="oe_highlight"/>
                        or
                        <button string="Cancel" class='oe_link' special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
