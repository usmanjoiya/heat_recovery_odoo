<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="quickbooks_online" string="QuickBooks Online">
                    <group>
                        <field name="qbo_state" readonly="1"/>
                        <field name="qbo_transaction_date" widget="datetime" readonly="1"/>
                        <field name="qbo_transaction_info" readonly="1"/>
                        <field name="qbo_product_ids">
                            <list>
                                <field name="qbo_id"/>
                                <field name="qbo_name"/>
                                <field name="is_imported"/>
                                <field name="is_exported"/>
                                <field name="company_id"/>
                            </list>
                        </field>
                    </group>
                    <group groups="base.group_no_one">
                        <div colspan="2">
                            <button type="object"
                                    name="to_qbo_json"
                                    class="btn btn-outline-primary"
                                    string="DISPLAY EXPORT JSON: debug"
                            />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_qbo_info_form" model="ir.ui.view">
        <field name="name">product.product.qbo.info.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Product QBO info" create="0" edit="0" delete="0">
                <header>
                    <button type='object' name='open_current_object' string="Open Full Form"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <hr/>
                    <group>
                        <field name="qbo_state" readonly="1"/>
                        <field name="qbo_transaction_date" widget="datetime" readonly="1"/>
                        <field name="qbo_transaction_info" readonly="1"/>
                        <field name="qbo_product_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qbo_todo_product_product" model="ir.ui.view">
        <field name="name">product.product.qbo.todo.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Products ToDo List" create="0" edit="0" delete="0"
                  decoration-info="qbo_state == 'pending'"
                  decoration-warning="qbo_state == 'rejected'"
                  decoration-danger="qbo_state == 'failed'">
                <field name="name"/>
                <field name="qbo_state"/>
                <field name="qbo_transaction_date" widget="datetime"/>
            </list>
        </field>
    </record>

    <record id="action_product_export_to_qbo" model="ir.actions.server">
        <field name="name">Export to QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="code">
            records.export_product_to_qbo()
        </field>
    </record>

    <record id="action_product_update_in_qbo" model="ir.actions.server">
        <field name="name">Update in QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="code">
            records.update_product_in_qbo()
        </field>
    </record>

    <record id="action_qbo_todo_product_product" model="ir.actions.act_window">
        <field name="name">Products ToDo List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_id" ref="view_qbo_todo_product_product"/>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_qbo_todo_product_product')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_qbo_info_form')})]"/>
        <field name="domain">
            [
                '|', '|',
                ('qbo_state', '=', 'pending'),
                ('qbo_state', '=', 'rejected'),
                ('qbo_state', '=', 'failed')
            ]
        </field>
    </record>

    <!-- product.template -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <field name="is_product_variant" invisible="1"/>
                <page name="quickbooks_online" string="QuickBooks Online" invisible="product_variant_count > 1 or is_product_variant">
                    <group>
                        <field name="qbo_state" readonly="1"/>
                        <field name="qbo_transaction_date" widget="datetime" readonly="1"/>
                        <field name="qbo_transaction_info" readonly="1"/>
                        <field name="qbo_product_ids">
                            <list>
                                <field name="qbo_id"/>
                                <field name="qbo_name"/>
                                <field name="is_imported"/>
                                <field name="is_exported"/>
                                <field name="company_id"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_product_export_to_qbo_tmpl" model="ir.actions.server">
        <field name="name">Export to QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="code">
            records.export_product_to_qbo_tmpl()
        </field>
    </record>
    <record id="action_product_update_in_qbo_tmpl" model="ir.actions.server">
        <field name="name">Update in QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="code">
            records.update_product_in_qbo_tmpl()
        </field>
    </record>

</odoo>
