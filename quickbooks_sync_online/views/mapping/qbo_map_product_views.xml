<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_product_list" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">Default list view for qbo.map.product</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_list"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_id']" position="before">
                <field name="id" groups="base.group_no_one"/>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="product_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_product_form" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">Default form view for qbo.map.product</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="replace"/>

            <xpath expr="//field[@name='qbo_id']" position="after">
                <field name="qbo_name"/>
                <field name="stock_keeping_unit" readonly="1"/>
                <field name="variant_options" readonly="1"/>
                <field name="product_id" force_save="1"
                       readonly="category_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="category_id" force_save="1"
                       readonly="product_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="product_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_product_search" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">Search into qbo product list</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="product_id"/>
                <field name="stock_keeping_unit"/>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">qbo.map.product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_product_list"/>
    </record>

    <record id="action_qbo_map_product_import_from_qbo" model="ir.actions.server">
        <field name="name">Import Products</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="code">
            model.get_data_from_qbo()
        </field>
    </record>

    <record id="action_qbo_map_product_try_map" model="ir.actions.server">
        <field name="name">Map by Name or Create</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="code">
            action = records.try_to_map()
        </field>
    </record>

    <record id="action_qbo_map_product_refresh_from_qbo" model="ir.actions.server">
        <field name="name">Refresh from QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_view_types">form</field>
<!--        <field name="groups_id" eval="[(6, 0, (ref('base.group_no_one'),))]"/>-->
        <field name="group_ids" eval="[(6, 0, (ref('base.group_no_one'),))]"/>
        <field name="code">
            record._refresh_qbo_mapping_body()
        </field>
    </record>

    <record id="action_force_update_products_to_qbo" model="ir.actions.server">
        <field name="name">Force update to QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_view_types">list,form</field>
<!--        <field name="groups_id" eval="[(6, 0, (ref('base.group_no_one'),))]"/>-->
        <field name="group_ids" eval="[(6, 0, (ref('base.group_no_one'),))]"/>
        <field name="code">
            records._action_force_update_map_to_qbo()
        </field>
    </record>

</odoo>
