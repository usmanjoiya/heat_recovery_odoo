<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_account_move_list" model="ir.ui.view">
        <field name="model">qbo.map.account.move</field>
        <field name="name">Default list view for qbo.map.account.move</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_list"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_id']" position="before">
                <field name="id" groups="base.group_no_one"/>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="invoice_id"/>
                <field name="payment_state"/>
                <field name="partner_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_account_move_form" model="ir.ui.view">
        <field name="model">qbo.map.account.move</field>
        <field name="name">Default form view for qbo.map.account.move</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="invoice_id"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="qbo_lib_type"/>
                <field name="partner_id"/>
                <field name="total_tax"/>
                <field name="total_amt"/>
                <field name="qbo_tax_ids" readonly="1" widget="many2many_tags"/>
                <field name="invoice_link" widget="url"
                       invisible="qbo_lib_type in ('bill', 'vendorcredit', 'creditmemo')"/>
                <field name="invoice_map_line_ids" readonly="1">
                    <list>
                        <field name="line_num"/>
                        <field name="item_map_id"/>
                        <field name="tax_class"/>
                        <field name="tax_code"/>
                        <field name="tax_map_ids" widget="many2many_tags"/>
                    </list>
                </field>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="payment_state" invisible="qbo_lib_type == 'bill' or qbo_lib_type == 'vendorcredit'"/>
                <field name="payment_ids" invisible="qbo_lib_type == 'bill' or qbo_lib_type == 'vendorcredit'"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_account_move_search" model="ir.ui.view">
        <field name="model">qbo.map.account.move</field>
        <field name="name">Search into qbo.map.account.move list</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <filter
                    name="invoice"
                    string="Customer Invoice"
                    domain="[('qbo_lib_type', '=', 'invoice')]"
                />
                <filter
                    name="creditmemo"
                    string="Customer Credit"
                    domain="[('qbo_lib_type', '=', 'creditmemo')]"
                />
                <filter
                    name="bill"
                    string="Vendor Bill"
                    domain="[('qbo_lib_type', '=', 'bill')]"
                />
                <filter
                    name="vendorcredit"
                    string="Vendor Refund"
                    domain="[('qbo_lib_type', '=', 'vendorcredit')]"
                />
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">qbo.map.account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_account_move_list"/>
    </record>

    <record id="action_qbo_map_account_move_import_from_qbo" model="ir.actions.server">
        <field name="name">Import Invoices</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_account_move"/>
        <field name="code">
            model.get_data_from_qbo()
        </field>
    </record>

    <record id="action_qbo_map_invoice_refresh_from_qbo" model="ir.actions.server">
        <field name="name">Refresh from QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_account_move"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_account_move"/>
        <field name="binding_view_types">form</field>
<!--        <field name="groups_id" eval="[(6, 0, (ref('base.group_no_one'),))]"/>-->
        <field name="group_ids" eval="[(6, 0, (ref('base.group_no_one'),))]"/>
        <field name="code">
            record._refresh_qbo_mapping_body()
        </field>
    </record>

</odoo>
