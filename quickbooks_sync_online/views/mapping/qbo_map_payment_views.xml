<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_payment_list" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">Default list view for qbo.map.payment</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_list"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_id']" position="before">
                <field name="id" groups="base.group_no_one"/>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sync_token" readonly="1" optional="hide"/>
                <field name="payment_id"/>
                <field name="invoice_id" optional="hide"/>
                <field name="txn_amount" readonly="1"/>
                <field name="currency_ref" readonly="1"/>
                <field name="is_imported" optional="hide"/>
                <field name="is_exported" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_payment_form" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">Default form view for qbo.map.payment</field>
        <field name="type">form</field>
        <field type="xml" name="arch">
            <form string="Payment" create="false" edit="false">
                <group>
                    <field name="is_imported" invisible="not is_imported"/>
                    <field name="is_exported" invisible="not is_imported"/>
                    <field name="qbo_id"/>
                    <field name="qbo_name"/>
                    <field name="txn_id"/>
                    <field name="invoice_id" groups="base.group_no_one"/>
                    <field name="update_point"/>
                    <field name="payment_id"/>
                    <field name="txn_type"/>
                    <field name="txn_amount"/>
                    <field name="currency_ref"/>
                    <field name="pay_method"/>
                    <field name="txn_date"/>
                    <field name="sync_token" readonly="1"/>
                    <field name="company_id"/>
                    <field name="qbo_object"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_qbo_map_payment_search" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">Search into qbo payment list</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="payment_id"/>
                <field name="invoice_id"/>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">qbo.map.payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_payment_list"/>
    </record>

    <record id="action_qbo_map_payment_import_from_qbo" model="ir.actions.server">
        <field name="name">Import Payments</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_payment"/>
        <field name="code">
            model.get_data_from_qbo()
        </field>
    </record>

    <record id="action_qbo_map_payment_refresh_from_qbo" model="ir.actions.server">
        <field name="name">Refresh from QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_payment"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_payment"/>
        <field name="binding_view_types">form</field>
<!--        <field name="groups_id" eval="[(6, 0, (ref('base.group_no_one'),))]"/>-->
        <field name="group_ids" eval="[(6, 0, (ref('base.group_no_one'),))]"/>
        <field name="code">
            record._refresh_qbo_mapping_body()
        </field>
    </record>

    <record id="action_qbo_map_payment_register_payment" model="ir.actions.server">
        <field name="name">Register Payment</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_payment"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_payment"/>
        <field name="code">
            records.register_payment()
        </field>
    </record>

</odoo>
