<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_taxcode_list" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">Default list view for qbo.map.taxcode</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_list"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sales_tax_rate_id" readonly="1"/>
                <field name="purchase_tax_rate_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_taxcode_form" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">Default form view for qbo.map.taxcode</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sales_tax_rate_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="purchase_tax_rate_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_taxcode_search" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">Search into qbo taxcode list</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_name"/>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_taxcode" model="ir.actions.act_window">
        <field name="name">Taxcodes</field>
        <field name="res_model">qbo.map.taxcode</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_taxcode_list"/>
    </record>

    <record id="action_qbo_map_taxcode_import_from_qbo" model="ir.actions.server">
        <field name="name">Import Taxcodes</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_taxcode"/>
        <field name="code">
            model.get_data_from_qbo()
        </field>
    </record>

</odoo>
