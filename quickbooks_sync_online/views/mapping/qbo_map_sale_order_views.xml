<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_sale_order_list" model="ir.ui.view">
        <field name="model">qbo.map.sale.order</field>
        <field name="name">Default list view for qbo.map.sale.order</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_list"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="total_tax"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_sale_order_form" model="ir.ui.view">
        <field name="model">qbo.map.sale.order</field>
        <field name="name">Default form view for qbo.map.sale.order</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="order_id"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="qbo_lib_type"/>
                <field name="partner_id"/>
                <field name="qbo_tax_ids" readonly="1" widget="many2many_tags"/>
                <field name="total_tax" readonly="1"/>
                <field name="order_map_line_ids" readonly="1">
                    <list>
                        <field name="line_num"/>
                        <field name="item_map_id"/>
                        <field name="tax_class"/>
                        <field name="tax_code"/>
                        <field name="tax_map_ids" widget="many2many_tags"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Receipts</field>
        <field name="res_model">qbo.map.sale.order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_sale_order_list"/>
    </record>

</odoo>
