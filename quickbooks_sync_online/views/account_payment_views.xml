<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/." position="inside">
                <notebook invisible="payment_type == 'transfer'">
                    <page name="quickbooks_online" string="QuickBooks Online">
                        <group>
                            <field name="qbo_state" readonly="0"/>
                            <field name="job_transaction_count" readonly="0"/>
                            <field name="qbo_transaction_date" widget="datetime" readonly="1"/>
                            <field name="qbo_transaction_info" readonly="1"/>
                            <field name="qbo_payment_ids">
                                <list>
                                    <field name="qbo_id"/>
                                    <field name="qbo_name"/>
                                    <field name="invoice_id"/>
                                    <field name="txn_amount"/>
                                    <field name="is_imported"/>
                                    <field name="is_exported"/>
                                </list>
                            </field>
                        </group>
                        <group groups="base.group_no_one">
                            <div colspan="2">
                                <button type="object"
                                        name="to_qbo_json"
                                        class="btn btn-outline-primary"
                                        string="DISPLAY EXPORT JSON: debug"
                                />
                            </div>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_qbo_info_form" model="ir.ui.view">
        <field name="name">account.payment.qbo.info.form</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <form string="Payment QBO info" create="0" edit="0" delete="0">
                <header>
                    <button type='object' name='open_current_object' string="Open Full Form"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <hr/>
                    <group>
                        <field name="qbo_state" readonly="1"/>
                        <field name="qbo_transaction_date" widget="datetime" readonly="1"/>
                        <field name="qbo_transaction_info" readonly="1"/>
                        <field name="qbo_payment_ids">
                            <list>
                                <field name="qbo_id"/>
                                <field name="qbo_name"/>
                                <field name="invoice_id"/>
                                <field name="txn_amount"/>
                                <field name="is_imported"/>
                                <field name="is_exported"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qbo_todo_account_payment" model="ir.ui.view">
        <field name="name">account.payment.qbo.todo.list</field>
        <field name="model">account.payment</field>
        <field name="priority" eval="33"/>
        <field name="arch" type="xml">
            <list string="Payments ToDo List" create="0" edit="0" delete="0"
                  decoration-info="qbo_state == 'pending'"
                  decoration-warning="qbo_state == 'rejected'"
                  decoration-danger="qbo_state == 'failed'">
                <field name="name"/>
                <field name="qbo_state"/>
                <field name="qbo_transaction_date" widget="datetime"/>
            </list>
        </field>
    </record>

    <record id="action_payment_export_to_qbo" model="ir.actions.server">
        <field name="name">Export to QBO</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="code">
            records.export_payment_to_qbo()
        </field>
    </record>

    <record id="action_qbo_todo_account_payment" model="ir.actions.act_window">
        <field name="name">Payments ToDo List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_id" ref="account.view_account_payment_form"/>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_qbo_todo_account_payment')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_payment_qbo_info_form')})]"/>
        <field name="domain">[('state', '=', 'posted'), ('qbo_state', '!=', 'proxy')]</field>
        <field name="context">{'qbo_todo_list_action': True}</field>
    </record>

</odoo>