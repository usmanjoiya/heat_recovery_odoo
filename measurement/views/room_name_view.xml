<odoo>
    <!-- Tree/List View -->
    <record id="view_room_name_list" model="ir.ui.view">
        <field name="name">room.name.list</field>
        <field name="model">room.name</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_room_name_form" model="ir.ui.view">
        <field name="name">room.name.form</field>
        <field name="model">room.name</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_room_name" model="ir.actions.act_window">
        <field name="name">Room Name</field>
        <field name="res_model">room.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item under Sales > Configuration -->
    <menuitem id="menu_room_name"
              name="Room Names"
              parent="menu_my_custom_config_root"
              action="action_room_name"
              sequence="60"/>
</odoo>
